// --- Giriş Birimleri ---
input {
    device "at-translated-set-2-keyboard" {
        ignore-device
    }
    keyboard {
        xkb {
            layout "tr"
        }
    }
    touchpad {
        tap
        natural-scroll
        dwt // typing yaparken touchpad'i kapat
    }
}

// --- Layout (Niri'nin Kalbi) ---
layout {
    gap 12
    center-focused-column "never"
    
    // Pencerelerin varsayılan genişliği (ekranın yarısı)
    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#7aa2f7" // Tokyo Night blue gibi
        inactive-color "#444444"
    }
}

// --- Kısayollar (Binds) ---
binds {
    // Terminal ve Launcher
    Mod+Return { spawn "kitty"; }
    Mod+D { spawn "fuzzel"; }
    Mod+Q { close-window; }

    // Sütunlar Arası Gezinti (Hyprland'deki gibi)
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }

    // Sütun Taşıma
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    // Mouse ile Pencere Boyutlandırma
    Mod+MouseLeft  { drag-window; }
    Mod+MouseRight { drag-window-resize; }

    // Scroll (Fare tekerleği ile sütunlar arası geçiş)
    Mod+WheelScrollDown      cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-column-left; }

    // Çıkış
    Mod+Shift+E { quit; }
    
    // Screenshot (Niri'nin kendi aracı çok iyidir)
    Print { screenshot; }
    Mod+Print { screenshot-screen; }
}

// --- Otomatik Başlatma ---
spawn-at-startup "waybar"
